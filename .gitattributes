# Default to LF line endings across all platforms (Windows dev -> Linux container deploy)
* text=auto eol=lf

# Explicitly enforce LF for Docker, scripts, configs, and source files
Dockerfile text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.sln text eol=lf
*.cshtml text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
.env* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
