# =============================================================================
# Payé Base — Plantilla de variables de entorno (.env.example)
# NUNCA guardes secretos reales en este archivo ni subas .env al repositorio.
# =============================================================================

# Entorno de ejecución (Development | Production)
ASPNETCORE_ENVIRONMENT=Production

# Base de datos PostgreSQL (usuario de aplicación con permisos mínimos, sin superuser)
POSTGRES_DB=paye_client_db
POSTGRES_USER=paye_app_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=paye_client_db;Username=paye_app_user;Password=CHANGE_ME_STRONG_DB_PASSWORD

# Base de datos exclusiva para pruebas automatizadas (DEBE ser distinta de DefaultConnection)
TEST_DATABASE_URL=Host=localhost;Port=5432;Database=paye_test_db;Username=paye_test_user;Password=CHANGE_ME_TEST_PASSWORD

# Configuración del cliente (single-tenant por despliegue)
CLIENT_BUSINESS_NAME=CHANGE_ME_NOMBRE_COMERCIO
ClientSettings__BusinessName=CHANGE_ME_NOMBRE_COMERCIO
ClientSettings__ContactEmail=contacto@ejemplo.es
ClientSettings__ContactPhone=+34 600 000 000
ClientSettings__LogoPath=/img/logo-placeholder.svg
ClientSettings__TimeZoneId=Europe/Madrid
ClientSettings__DefaultCulture=es-ES

# Seguridad y persistencia de volúmenes
Security__DataProtectionKeysPath=/var/lib/paye/keys
Security__PrivateUploadsPath=/var/lib/paye/private-uploads
# Proxies inversos de confianza (Coolify / Traefik), p. ej. Security__TrustedProxies__0=172.18.0.1
# Orígenes CORS permitidos explícitos (dejar vacío para mismo origen estricto)

# =============================================================================
# SIEMBRA INICIAL DEL PRIMER USUARIO PROPIETARIO
# IMPORTANTE:
# 1. Define estas variables SOLO para el primer arranque o comando de siembra inicial.
# 2. La contraseña debe tener un mínimo de 12 caracteres, mayúsculas, minúsculas, dígito y símbolo.
# 3. BORRA ESTAS VARIABLES DEL PANEL DE COOLIFY / .env INMEDIATAMENTE DESPUÉS DEL PRIMER ARRANQUE.
# =============================================================================
SEED_OWNER_EMAIL=
SEED_OWNER_FULLNAME=
SEED_OWNER_PASSWORD=

# Proveedor SMTP (opcional; si no se configura, la recuperación de contraseña avisará claramente)
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=
Smtp__FromName=

# Integraciones externas (desactivadas automáticamente si no se configuran)
Integrations__Gemini__ApiKey=
Integrations__Google__ClientId=
Integrations__Google__ClientSecret=
