@model Paye.Web.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<section class="card">
    <h1>Cambiar contraseña</h1>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <form asp-action="ChangePassword" asp-controller="Account" method="post" novalidate>
        <div class="form-group">
            <label asp-for="CurrentPassword">Contraseña actual</label>
            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="NewPassword">Nueva contraseña (mínimo 12 caracteres)</label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword">Confirmar nueva contraseña</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Actualizar contraseña</button>
        </div>
    </form>
</section>
