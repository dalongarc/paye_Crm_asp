@model Paye.Web.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    var smtpConfigured = ViewData["SmtpConfigured"] as bool? ?? false;
}

<section class="auth-card card">
    <h1>Recuperación de contraseña</h1>

    @if (!smtpConfigured)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Servicio de correo no configurado:</strong> El envío de correo (SMTP) no está configurado en este servidor.
            Contacte con el propietario del negocio para restablecer su contraseña desde el panel de administración.
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <form asp-action="ForgotPassword" asp-controller="Account" method="post" novalidate>
        <div class="form-group">
            <label asp-for="Email">Correo electrónico</label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Enviar enlace de recuperación</button>
            <a asp-action="Login" asp-controller="Account" class="link-secondary">Volver al acceso</a>
        </div>
    </form>
</section>
