@model Paye.Web.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<section class="auth-card card">
    <h1>Restablecer contraseña</h1>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <form asp-action="ResetPassword" asp-controller="Account" method="post" novalidate>
        <input type="hidden" asp-for="Token" />
        <input type="hidden" asp-for="Email" />

        <div class="form-group">
            <label asp-for="NewPassword">Nueva contraseña (mínimo 12 caracteres)</label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword">Confirmar nueva contraseña</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Guardar contraseña</button>
        </div>
    </form>
</section>
