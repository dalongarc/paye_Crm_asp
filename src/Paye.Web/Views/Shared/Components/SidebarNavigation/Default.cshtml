@model IReadOnlyList<Paye.Web.ViewComponents.SidebarMenuItemViewModel>

@if (Model.Count > 0)
{
    <aside class="app-sidebar" aria-label="Menú lateral de módulos">
        <nav class="sidebar-nav">
            <ul class="sidebar-menu">
                @foreach (var item in Model)
                {
                    <li class="sidebar-menu-item">
                        <a href="@item.Url"
                           class="sidebar-link @(item.IsActive ? "active" : "")"
                           aria-current="@(item.IsActive ? "page" : null)">
                            <span class="sidebar-icon @item.IconCssClass" aria-hidden="true"></span>
                            <span class="sidebar-label">@item.Title</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </aside>
}
