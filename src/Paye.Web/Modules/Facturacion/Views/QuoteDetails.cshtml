@model Paye.Web.Modules.Facturacion.QuoteDetailsViewModel
@using Paye.Core.Modules.Facturacion
@{
    var q = Model.Quote;
    ViewData["Title"] = $"Presupuesto {q.FormattedNumber}";
}

<section class="card">
    <div class="section-header">
        <div>
            <h1>Presupuesto @q.FormattedNumber</h1>
            <p class="text-muted">Estado: <strong>@q.Status</strong> | Fecha: @q.IssueDate.ToString("dd/MM/yyyy")</p>
        </div>
        <div class="inline-form">
            <a asp-controller="Facturacion" asp-action="Index" asp-route-tab="presupuestos" class="btn btn-secondary btn-sm">Volver</a>
            @if (Model.CanDownload)
            {
                <a asp-controller="Facturacion" asp-action="DownloadQuotePdf" asp-route-id="@q.Id" class="btn btn-outline btn-sm">Descargar PDF</a>
            }
            @if (Model.CanCreate && !q.ConvertedInvoiceId.HasValue && (q.Status == QuoteStatus.Borrador || q.Status == QuoteStatus.Enviado))
            {
                <a asp-controller="Facturacion" asp-action="EditQuote" asp-route-id="@q.Id" class="btn btn-secondary btn-sm">Editar</a>
            }
        </div>
    </div>

    <div class="dashboard-grid">
        <div>
            <h2>Datos del cliente</h2>
            <p><strong>@q.CustomerName</strong></p>
            <p>NIF/CIF: @(string.IsNullOrWhiteSpace(q.CustomerTaxId) ? "—" : q.CustomerTaxId)</p>
            <p>Dirección: @(string.IsNullOrWhiteSpace(q.CustomerAddress) ? "—" : q.CustomerAddress)</p>
        </div>
        <div>
            <h2>Resumen económico</h2>
            <p>Base imponible: <strong>@q.SubtotalNet.ToString("N2") €</strong></p>
            <p>IVA + Recargo: <strong>@q.TotalTax.ToString("N2") €</strong></p>
            @if (q.TotalWithholding > 0m)
            {
                <p>Retención IRPF (@q.WithholdingPercentage.ToString("N2") %): <strong>-@q.TotalWithholding.ToString("N2") €</strong></p>
            }
            <p>Total a pagar: <strong>@q.TotalPayable.ToString("N2") €</strong></p>
        </div>
    </div>

    <h2>Líneas</h2>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Concepto</th>
                    <th class="text-right">Cant.</th>
                    <th class="text-right">Precio neto</th>
                    <th class="text-right">IVA %</th>
                    <th class="text-right">Importe neto</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in q.Lines)
                {
                    <tr>
                        <td>@line.LineOrder</td>
                        <td>@line.Description</td>
                        <td class="text-right">@line.Quantity.ToString("N2")</td>
                        <td class="text-right">@line.UnitPriceNet.ToString("N2") €</td>
                        <td class="text-right">@line.VatPercentage.ToString("N2") %</td>
                        <td class="text-right"><strong>@line.LineNet.ToString("N2") €</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.CanCreate && !q.ConvertedInvoiceId.HasValue)
    {
        <div class="form-actions">
            @if (q.Status == QuoteStatus.Borrador)
            {
                <form method="post" asp-controller="Facturacion" asp-action="ChangeQuoteStatus" asp-route-id="@q.Id" class="inline-form">
                    <input type="hidden" name="Id" value="@q.Id" />
                    <input type="hidden" name="NewStatus" value="@QuoteStatus.Enviado" />
                    <input type="hidden" name="RowVersion" value="@q.RowVersion" />
                    <button type="submit" class="btn btn-secondary btn-sm">Marcar como Enviado</button>
                </form>
            }
            @if (q.Status == QuoteStatus.Borrador || q.Status == QuoteStatus.Enviado)
            {
                <form method="post" asp-controller="Facturacion" asp-action="ChangeQuoteStatus" asp-route-id="@q.Id" class="inline-form">
                    <input type="hidden" name="Id" value="@q.Id" />
                    <input type="hidden" name="NewStatus" value="@QuoteStatus.Aceptado" />
                    <input type="hidden" name="RowVersion" value="@q.RowVersion" />
                    <button type="submit" class="btn btn-primary btn-sm">Marcar como Aceptado</button>
                </form>
            }
            @if (q.Status == QuoteStatus.Aceptado)
            {
                <form method="post" asp-controller="Facturacion" asp-action="ConvertQuoteToInvoice" asp-route-id="@q.Id" class="inline-form">
                    <button type="submit" class="btn btn-primary btn-sm">Convertir en borrador de factura</button>
                </form>
            }
        </div>
    }
    @if (q.ConvertedInvoiceId.HasValue)
    {
        <div class="alert alert-success">
            Convertido en factura: <a asp-controller="Facturacion" asp-action="InvoiceDetails" asp-route-id="@q.ConvertedInvoiceId.Value">Ver factura vinculada</a>
        </div>
    }
</section>
