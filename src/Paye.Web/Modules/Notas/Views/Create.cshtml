@model Paye.Web.Modules.Notas.CreateNotaInputModel
@{
    ViewData["Title"] = "Nueva nota";
}

<section class="card">
    <div class="section-header">
        <h1>Crear nueva nota</h1>
        <a asp-controller="Notas" asp-action="Index" class="btn btn-secondary">Volver al listado</a>
    </div>

    <form asp-controller="Notas" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-group">
            <label asp-for="Titulo">Título</label>
            <input asp-for="Titulo" class="form-control" maxlength="150" required />
            <span asp-validation-for="Titulo" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Contenido">Contenido</label>
            <textarea asp-for="Contenido" class="form-control" rows="6" maxlength="4000" required></textarea>
            <span asp-validation-for="Contenido" class="text-danger"></span>
        </div>

        <div class="form-check">
            <input asp-for="Archivada" type="checkbox" />
            <label asp-for="Archivada">Marcar como archivada</label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Guardar nota</button>
            <a asp-controller="Notas" asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</section>
